{
  "description": "AEGIS agentic guards (SPDX: LicenseRef-PolyForm-Noncommercial-1.0.0). Start Codex from the repository root that holds .agentic/, trust the project, and review these hooks so they run. See .codex/README.md and .agentic/hooks/README.md.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node .agentic/tools/run_hook.mjs .agentic/hooks/guard_read_path.py",
            "commandWindows": "node .agentic\\tools\\run_hook.mjs .agentic\\hooks\\guard_read_path.py",
            "statusMessage": "Checking configured read policy"
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .agentic/tools/run_hook.mjs .agentic/hooks/guard_write_zone.py",
            "commandWindows": "node .agentic\\tools\\run_hook.mjs .agentic\\hooks\\guard_write_zone.py",
            "statusMessage": "Checking agentic write zone"
          },
          {
            "type": "command",
            "command": "node .agentic/tools/run_hook.mjs .agentic/hooks/secret_scan.py",
            "commandWindows": "node .agentic\\tools\\run_hook.mjs .agentic\\hooks\\secret_scan.py",
            "statusMessage": "Checking edit content for secrets"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .agentic/tools/run_hook.mjs .agentic/hooks/guard_shell_write.py",
            "commandWindows": "node .agentic\\tools\\run_hook.mjs .agentic\\hooks\\guard_shell_write.py",
            "statusMessage": "Checking agentic write zone for shell writes"
          },
          {
            "type": "command",
            "command": "node .agentic/tools/run_hook.mjs .agentic/hooks/secret_scan.py",
            "commandWindows": "node .agentic\\tools\\run_hook.mjs .agentic\\hooks\\secret_scan.py",
            "statusMessage": "Checking command for secrets"
          },
          {
            "type": "command",
            "command": "node .agentic/tools/run_hook.mjs .agentic/hooks/delivery_preflight.py",
            "commandWindows": "node .agentic\\tools\\run_hook.mjs .agentic\\hooks\\delivery_preflight.py",
            "statusMessage": "Checking delivery preflight"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .agentic/tools/run_hook.mjs .agentic/hooks/post_tool_evidence.py",
            "commandWindows": "node .agentic\\tools\\run_hook.mjs .agentic\\hooks\\post_tool_evidence.py",
            "statusMessage": "Recording agentic tool evidence"
          }
        ]
      }
    ]
  }
}
