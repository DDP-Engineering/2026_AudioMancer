{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "aegis",
  "instructions": [
    "AGENTS.md",
    ".agentic/documents/CLI_API_REFERENCE.md"
  ],
  "permission": {
    "skill": {
      "*": "allow"
    },
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/*.env": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*_rsa": "deny",
      "**/*_rsa.pub": "deny",
      "**/id_rsa": "deny",
      "**/id_rsa.pub": "deny",
      "**/id_ed25519": "deny",
      "**/id_ed25519.pub": "deny"
    },
    "edit": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/*.env": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*_rsa": "deny",
      "**/*_rsa.pub": "deny",
      "**/id_rsa": "deny",
      "**/id_rsa.pub": "deny",
      "**/id_ed25519": "deny",
      "**/id_ed25519.pub": "deny"
    },
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "gh pr create*": "ask",
      "git merge*": "ask",
      "npm publish*": "ask"
    },
    "external_directory": {
      "*": "ask"
    }
  }
}
