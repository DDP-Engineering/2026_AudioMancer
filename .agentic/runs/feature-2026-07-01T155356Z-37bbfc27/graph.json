  "spec_items": [
    {
      "examples": [
        "Prompt text includes source language, available source spans, no source_text/text output instructions, and a blocks array contract."
      ],
      "id": "SB456-SPEC-001",
      "statement": "Narrator-and-character Speech Blocks prompts shall use the multilingual source-span selection contract only, include the active source language including Romanian when applicable, prohibit translation or rewritten final text, require allowed source_span_ids only, and return JSON-only blocks.",
      "status": "accepted",
      "tag": "behavior",
      "threshold": null
    },
    {
      "examples": [
        "A Romanian alias appears in speaker_catalog_json, while previous/next halo previews appear separately and do not add sNNN ids."
      ],
      "id": "SB456-SPEC-002",
      "statement": "Speech Blocks prompt rendering shall expose source-language character names and aliases in the allowed speaker catalog and may include previous/next chunk halo text only as non-selectable attribution context, never as selectable source spans.",
      "status": "accepted",
      "tag": "behavior",
      "threshold": null
    },
    {
      "examples": [
        "Prompt checks cover cleanup preserving likely dialogue, translation preserving dialogue punctuation, and chunking avoiding boundaries around short attribution."
      ],
      "id": "SB456-SPEC-003",
      "statement": "Adjacent text cleanup, translation, and chunking guidance shall preserve multilingual dialogue punctuation, paragraph shape, and nearby attribution needed by Speech Blocks source-span selection.",
      "status": "accepted",
      "tag": "property",
      "threshold": null
    },
    {
      "examples": [
        "Local Speech Blocks docs recommend qwen/qwen3.6-27b and list top-p/top-k/repeat penalty only as LM Studio preset values, not AudioMancer fields."
      ],
      "id": "SB456-SPEC-004",
      "statement": "AudioMancer documentation and user guidance shall state that AI Settings sends only request-level model, context, max-output, temperature, timeout, and structured-output hints to LM Studio, while sampler controls such as top-p, top-k, repeat penalty, seed, and reasoning mode remain LM Studio preset settings unless provider payload support is added.",
      "status": "accepted",
      "tag": "property",
      "threshold": null
    }
